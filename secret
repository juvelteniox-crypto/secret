<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>A Letter for Eunice</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Pinyon+Script&display=swap">

<style>
:root{
  --bg-top:#FDE6EB;
  --bg-bottom:#EFE3FA;
  --rose:#E8607E;
  --rose-deep:#C93F63;
  --blush:#F7A8BA;
  --pink:#FCCBD7;
  --lilac:#BBA3EC;
  --lilac-deep:#9B80D8;
  --sage:#93BB9B;
  --sage-deep:#6E9F7E;
  --butter:#FFD76A;
  --butter-deep:#F0B73E;
  --paper:#FFFBF8;
  --line:#F4CBD5;
  --ink:#4A2735;
  --ink-soft:#7B4A5E;
  --script:'Pinyon Script','Snell Roundhand','Apple Chancery',cursive;
  --hand:'Gaegu','Segoe Print','Comic Sans MS',cursive;
  color-scheme:light;
}

*{box-sizing:border-box}
[hidden]{display:none!important}

body{
  margin:0;
  background-color:var(--bg-bottom);
  background-image:linear-gradient(180deg,var(--bg-top),var(--bg-bottom));
  background-repeat:no-repeat;
  color:var(--ink);
  font-family:var(--hand);
  -webkit-font-smoothing:antialiased;
}

/* Floating hearts */
.hearts{
  position:fixed;
  inset:0;
  overflow:hidden;
  pointer-events:none;
  z-index:0;
}

.fh{
  position:absolute;
  left:var(--x);
  bottom:-48px;
  opacity:var(--o);
  animation:rise var(--dur) linear var(--delay) infinite;
}

@keyframes rise{
  0%{
    transform:translate(0,0) rotate(-8deg);
    opacity:0;
  }
  10%{opacity:var(--o)}
  50%{transform:translate(22px,-58vh) rotate(8deg)}
  90%{opacity:var(--o)}
  100%{
    transform:translate(-12px,-118vh) rotate(-6deg);
    opacity:0;
  }
}

/* Main bouquet stage */
.stage{
  position:relative;
  z-index:1;
  display:grid;
  justify-items:center;
  gap:6px;
  padding-block:60px 32px;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
}

h1{
  margin:0;
  font:400 clamp(44px,11vw,64px)/1.05 var(--script);
  color:var(--rose-deep);
  text-align:center;
  text-wrap:balance;
}

.bouquet{
  position:relative;
  width:min(100%,400px,max(240px,calc((100svh - 190px) * .714)));
}

.bouquet svg#art{
  display:block;
  width:100%;
  height:auto;
  overflow:visible;
}

/* Envelope */
.env{
  position:absolute;
  left:50%;
  top:72.4%;
  width:23%;
  padding:0;
  border:0;
  background:none;
  cursor:pointer;
  transform:translate(-50%,-50%) rotate(-6deg);
  animation:sway 4.5s ease-in-out infinite alternate;
  filter:drop-shadow(0 6px 7px rgba(74,39,53,.24));
  -webkit-tap-highlight-color:transparent;
}

.env::after{
  content:"";
  position:absolute;
  inset:-12px;
}

.env svg{
  display:block;
  width:100%;
  height:auto;
}

.env:hover,.env:focus-visible{
  animation:none;
  transform:translate(-50%,-55%) rotate(0deg) scale(1.08);
}

.env:focus-visible{
  outline:3px solid var(--lilac-deep);
  outline-offset:6px;
  border-radius:8px;
}

@keyframes sway{
  from{transform:translate(-50%,-50%) rotate(-7deg)}
  to{transform:translate(-50%,-53%) rotate(-3deg)}
}

.seal{
  transform-box:fill-box;
  transform-origin:center;
  animation:beat 1.9s ease-in-out infinite;
}

@keyframes beat{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.18)}
}

/* Spotify button */
.music{
  position:fixed;
  z-index:30;
  top:calc(14px + env(safe-area-inset-top,0px));
  right:calc(14px + env(safe-area-inset-right,0px));
  display:inline-flex;
  align-items:center;
  gap:8px;
  min-height:44px;
  padding:0 18px 0 13px;
  border-radius:999px;
  background:rgba(255,251,248,.88);
  color:var(--ink);
  font:700 19px/1 var(--hand);
  text-decoration:none;
  box-shadow:0 6px 18px rgba(201,63,99,.18),
    inset 0 0 0 1.5px var(--pink);
  -webkit-backdrop-filter:blur(6px);
  backdrop-filter:blur(6px);
}

.music svg{
  width:20px;
  height:20px;
  fill:var(--rose);
}

.music:hover{background:var(--paper)}

.music:focus-visible,
.close:focus-visible{
  outline:3px solid var(--lilac-deep);
  outline-offset:3px;
}

/* Letter overlay */
.letter{
  position:fixed;
  inset:0;
  z-index:20;
  overflow-y:auto;
  overscroll-behavior:contain;
  padding:
    calc(70px + env(safe-area-inset-top,0px))
    max(16px,env(safe-area-inset-right,0px))
    calc(108px + env(safe-area-inset-bottom,0px))
    max(16px,env(safe-area-inset-left,0px));
  background:rgba(251,222,230,.74);
  -webkit-backdrop-filter:blur(10px);
  backdrop-filter:blur(10px);
  opacity:0;
  transition:opacity .35s ease;
}

.letter.on{opacity:1}

.sheet{
  position:relative;
  max-width:560px;
  margin-inline:auto;
  padding:46px 20px 40px 50px;
  background:var(--paper);
  border-radius:6px;
  box-shadow:0 2px 0 var(--line),
    0 24px 50px -16px rgba(201,63,99,.4);
  transform:translateY(44px) rotate(-.8deg) scale(.96);
  transition:transform .55s cubic-bezier(.2,.8,.2,1);
  outline:none;
}

.letter.on .sheet{transform:none}

.sheet::before{
  content:"";
  position:absolute;
  top:0;
  bottom:0;
  left:38px;
  width:2px;
  background:var(--blush);
  opacity:.7;
}

.sheet::after{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 18px 12%,var(--line) 0 6px,transparent 7px),
    radial-gradient(circle at 18px 50%,var(--line) 0 6px,transparent 7px),
    radial-gradient(circle at 18px 88%,var(--line) 0 6px,transparent 7px);
}

.tape{
  position:absolute;
  top:-13px;
  left:50%;
  width:112px;
  height:28px;
  transform:translateX(-50%) rotate(-3deg);
  background:repeating-linear-gradient(
    135deg,
    rgba(187,163,236,.6) 0 8px,
    rgba(206,189,243,.6) 8px 16px
  );
}

.close{
  position:absolute;
  top:8px;
  right:8px;
  z-index:2;
  width:44px;
  height:44px;
  display:grid;
  place-items:center;
  border:0;
  border-radius:50%;
  background:none;
  color:var(--ink-soft);
  cursor:pointer;
}

.close:hover{background:var(--pink)}

.close svg{
  width:20px;
  height:20px;
  stroke:currentColor;
  stroke-width:2.2;
  stroke-linecap:round;
  fill:none;
}

.lines{
  position:relative;
  z-index:1;
  background-image:repeating-linear-gradient(
    to bottom,
    transparent 0 35px,
    var(--line) 35px 36px
  );
  font:400 22px/36px var(--hand);
  color:var(--ink);
  overflow-wrap:break-word;
}

.lines p{margin:0 0 36px}

.lines .to{
  font:400 33px/36px var(--script);
  color:var(--rose-deep);
}

.lines .from{
  margin:0;
  text-align:right;
}

.lines .name{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font:400 38px/36px var(--script);
  color:var(--rose-deep);
}

.lines .name svg{
  width:20px;
  height:18px;
  fill:var(--rose);
}

/* Spotify player appears when letter opens */
.player{
  position:fixed;
  z-index:25;
  height:80px;
  max-width:560px;
  margin-inline:auto;
  left:max(16px,env(safe-area-inset-left,0px));
  right:max(16px,env(safe-area-inset-right,0px));
  bottom:calc(14px + env(safe-area-inset-bottom,0px));
  opacity:0;
  pointer-events:none;
  transition:opacity .4s ease .3s;
}

.player.on{
  opacity:1;
  pointer-events:auto;
}

.player iframe{
  display:block;
  width:100%;
  border-radius:12px;
}

/* Accessibility */
@media (prefers-reduced-motion:reduce){
  .fh{
    animation:none;
    bottom:auto;
    top:var(--y);
  }
  .env,.seal{animation:none}
  .letter,.sheet{transition:none}
}
</style>
</head>

<body>

<svg width="0" height="0" style="position:absolute"
     aria-hidden="true" focusable="false">
  <defs>
    <path id="heart"
      d="M0 .8C-1.3-.2-1-1-.45-1C-.15-1 0-.75 0-.6C0-.75 .15-1 .45-1C1-1 1.3-.2 0 .8Z"/>
  </defs>
</svg>

<div class="hearts" id="hearts" aria-hidden="true"></div>

<a class="music"
   href="https://open.spotify.com/track/7CklpvSWzSiPDMeN02SkSR"
   target="_blank"
   rel="noopener noreferrer"
   aria-label="Play the song on Spotify">

  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M9 3v10.55A4 4 0 1 0 11 17V7h4V3H9z"/>
  </svg>

  <span>Play</span>
</a>

<main class="stage">
  <h1>Eunice Asha</h1>

  <div class="bouquet">
    <svg id="art" viewBox="0 0 400 560"
         role="img"
         aria-label="A bouquet of flowers tied with a pink ribbon">
    </svg>

    <button class="env" id="open" type="button"
            aria-label="Open the letter">
      <svg viewBox="0 0 120 86" aria-hidden="true">
        <rect x="3" y="8" width="114" height="74" rx="7"
              style="fill:var(--paper);stroke:var(--blush);stroke-width:2"/>

        <path d="M7 78L46 43M113 78L74 43"
              style="fill:none;stroke:var(--blush);stroke-width:1.6;stroke-linecap:round;opacity:.7"/>

        <path d="M3 15Q3 8 10 8H110Q117 8 117 15L65 52Q60 55 55 52Z"
              style="fill:var(--pink);stroke:var(--blush);stroke-width:2;stroke-linejoin:round"/>

        <g transform="translate(60 49)">
          <g class="seal">
            <use href="#heart" transform="scale(11)"
                 style="fill:var(--rose)"/>
          </g>
        </g>
      </svg>
    </button>
  </div>
</main>

<div class="letter" id="letter"
     role="dialog" aria-modal="true"
     aria-label="Letter" hidden>

  <article class="sheet" id="sheet" tabindex="-1">
    <span class="tape" aria-hidden="true"></span>

    <button class="close" id="close" type="button"
            aria-label="Close the letter">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M4 4L16 16M16 4L4 16"/>
      </svg>
    </button>

    <div class="lines">
      <p class="to">To my Dearest Eunice Asha,</p>

      <p>I know this may seem unexpected like really jud, I've been thinking about telling you this for so many times now, but I never knew how to put this into words. Ge agi lang nako sa pa dungog² sa instagram and i know kabantay sad ka hihi, wala man anta koy plano e pursue ni nga feeling since aware man sad ko nga naay someone nag court nimo and diko nahan maki epal sa laing relasyon huhu, honestly i like admiring you from afar, you're cute, beautiful, gorgeous, ug more pa you caught my eye since first day sa school pero ahu lang ge keep to myself HAHAHAHA. Dili raman pud sie kanaa ahung nabantayan, i like the way you portray yourself to other peoplee like really you look clean talaga in my eyess wowtch like the aura and everyhthing, You have such a nice smile:) and maka sense kog batak sa acads inside youuu labi nag mag reporting or ingana hihihi grabeee, sige nilahat mo na yung standards koo ayyy.</p>

      <p>I never thought this feeling would grow so much &gt;&lt;, happy crush raman anta HAHAHAH na para bang charizz, I'm not expecting anything from this message, I'm not expecting you to like me back, but my feelings for you will always be certain and genuine, whatever your answer may be, I'm glad I got the courage to tell you. Because I believe taking the chance is better than losing it.</p>

      <p class="from">
        From,<br>
        <span class="name">
          Juveltch
          <svg viewBox="-1.1 -1.1 2.2 2" aria-hidden="true">
            <use href="#heart"/>
          </svg>
        </span>
      </p>
    </div>
  </article>
</div>

<div class="player" id="player">
  <div id="embed"></div>
</div>

<script>
(function(){
  var NS='http://www.w3.org/2000/svg';
  var reduce=window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  function rng(seed){
    return function(){
      seed|=0;
      seed=seed+0x6D2B79F5|0;
      var t=Math.imul(seed^seed>>>15,1|seed);
      t=t+Math.imul(t^t>>>7,61|t)^t;
      return((t^t>>>14)>>>0)/4294967296;
    };
  }

  function fill(c){
    return 'style="fill:var(--'+c+')"';
  }

  /* Daisy flowers */
  function daisy(x,y,r){
    var s='<g transform="translate('+x+' '+y+')"',n=11,i;
    s='<g transform="translate('+x+' '+y+')">';
    for(i=0;i<n;i++){
      s+='<ellipse cx="0" cy="'+(-r*.6)+
        '" rx="'+(r*.18)+
        '" ry="'+(r*.42)+
        '" transform="rotate('+(i*360/n)+')" '+
        'style="fill:var(--paper);stroke:var(--pink);stroke-width:1.2"/>';
    }
    return s+'<circle r="'+(r*.27)+'" '+fill('butter')+'/>'+
      '<circle r="'+(r*.11)+'" '+fill('butter-deep')+'/></g>';
  }

  /* Roses */
  function rose(x,y,r,c,d){
    var s='<g transform="translate('+x+' '+y+')',i,a;
    s='<g transform="translate('+x+' '+y+')">';
    for(i=0;i<5;i++){
      a=i*Math.PI*2/5+.3;
      s+='<circle cx="'+(Math.cos(a)*r*.74)+
        '" cy="'+(Math.sin(a)*r*.74)+
        '" r="'+(r*.38)+
        '" style="fill:var(--'+c+');stroke:var(--'+d+
        ');stroke-width:1.1;stroke-opacity:.4"/>';
    }
    s+='<circle r="'+(r*.8)+'" '+fill(c)+'/>';
    s+='<circle r="'+(r*.58)+'" style="fill:var(--'+c+
      ');stroke:var(--'+d+');stroke-width:1.3;stroke-opacity:.5"/>';
    s+='<path d="M'+(-r*.34)+' '+(r*.04)+
      'Q'+(-r*.32)+' '+(-r*.36)+' '+(r*.02)+' '+(-r*.34)+
      'Q'+(r*.38)+' '+(-r*.32)+' '+(r*.32)+' '+(r*.02)+
      'Q'+(r*.27)+' '+(r*.34)+' '+(-r*.03)+' '+(r*.29)+
      'Q'+(-r*.24)+' '+(r*.24)+' '+(-r*.17)+' '+(r*.02)+
      '" style="fill:none;stroke:var(--'+d+
      ');stroke-width:1.5;stroke-linecap:round;stroke-opacity:.8"/>';
    return s+'</g>';
  }

  /* Tulips */
  function tulip(x,y,s,c,d,rot){
    return '<g transform="translate('+x+' '+y+') rotate('+rot+')">'+
      '<path d="M'+(-s)+' '+(-s*.5)+
      'Q'+(-s*1.05)+' '+(s*.95)+' 0 '+s+
      'Q'+(s*1.05)+' '+(s*.95)+' '+s+' '+(-s*.5)+
      'L'+(s*.55)+' '+(-s*.15)+
      'L0 '+(-s*.85)+
      'L'+(-s*.55)+' '+(-s*.15)+'Z" '+
      'style="fill:var(--'+c+');stroke:var(--'+d+
      ');stroke-width:1.2;stroke-linejoin:round"/>'+
      '<path d="M0 '+(-s*.85)+
      'Q'+(-s*.28)+' '+(s*.2)+' 0 '+s+
      'Q'+(s*.28)+' '+(s*.2)+' 0 '+(-s*.85)+
      '" style="fill:var(--'+d+');opacity:.25"/></g>';
  }

  /* Decorative hearts in bouquet */
  function heart(x,y,s,c,rot){
    return '<g transform="translate('+x+' '+y+') rotate('+rot+
      ') scale('+s+')">'+
      '<use href="#heart" style="fill:var(--'+c+
      ');stroke:var(--rose-deep);stroke-width:.06;stroke-linejoin:round"/>'+
      '<ellipse cx="-.5" cy="-.52" rx=".2" ry=".1" '+
      'transform="rotate(-30 -.5 -.52)" '+
      'style="fill:var(--paper);opacity:.6"/></g>';
  }

  /* Small flower clusters */
  function cluster(x,y,r,c,d,seed){
    var R=rng(seed),s='<g transform="translate('+x+' '+y+')">',
        i,k,a,dd,px,py,aa;

    for(i=0;i<9;i++){
      a=R()*6.283;
      dd=Math.sqrt(R())*r;
      px=Math.cos(a)*dd;
      py=Math.sin(a)*dd;

      for(k=0;k<4;k++){
        aa=k*Math.PI/2+.4;
        s+='<circle cx="'+(px+Math.cos(aa)*3.6)+
          '" cy="'+(py+Math.sin(aa)*3.6)+
          '" r="3.5" '+fill(c)+'/>';
      }

      s+='<circle cx="'+px+'" cy="'+py+
        '" r="1.7" '+fill(d)+'/>';
    }

    return s+'</g>';
  }

  /* Green leaves */
  function leaf(a,len,c){
    return '<path transform="translate(200 268) rotate('+a+
      ')" d="M0 0Q'+(len*.14)+' '+(-len*.45)+
      ' 0 '+(-len)+'Q'+(-len*.14)+' '+(-len*.45)+
      ' 0 0Z" '+fill(c)+'/>'+
      '<path transform="translate(200 268) rotate('+a+
      ')" d="M0 -6L0 '+(-len*.82)+
      '" style="fill:none;stroke:var(--paper);stroke-width:1;opacity:.4"/>';
  }

  /* Draw bouquet */
  (function(){
    var out='',R=rng(7),i,rad,L,x,y;

    out+='<ellipse cx="200" cy="554" rx="58" ry="5" '+
      'style="fill:var(--ink);opacity:.14"/>';

    var ang=[-76,-58,-40,-20,0,20,40,58,76];
    var len=[130,150,170,180,175,180,170,150,130];

    for(i=0;i<ang.length;i++){
      out+=leaf(ang[i],len[i],i%2?'sage-deep':'sage');
    }

    for(i=0;i<34;i++){
      rad=(-80+R()*160)*Math.PI/180;
      L=130+R()*58;
      x=200+Math.sin(rad)*L;
      y=268-Math.cos(rad)*L;

      out+='<line x1="200" y1="268" x2="'+x.toFixed(1)+
        '" y2="'+y.toFixed(1)+
        '" style="stroke:var(--sage-deep);stroke-width:1;opacity:.55"/>'+
        '<circle cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+
        '" r="3.4" style="fill:var(--paper)"/>'+
        '<circle cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+
        '" r="1.2" '+fill('blush')+'/>';
    }

    out+=tulip(200,98,24,'lilac','lilac-deep',0);
    out+=tulip(146,124,22,'pink','rose',-20);
    out+=tulip(254,122,22,'blush','rose',20);

    out+=cluster(96,196,26,'lilac','lilac-deep',3);
    out+=cluster(304,194,26,'lilac','lilac-deep',5);

    out+=rose(124,168,30,'blush','rose-deep');
    out+=rose(278,166,30,'rose','rose-deep');

    out+=daisy(200,152,34);
    out+=daisy(70,226,22);
    out+=daisy(332,224,22);

    out+=rose(160,214,28,'rose','rose-deep');
    out+=heart(240,212,26,'rose',12);

    out+=daisy(112,236,24);
    out+=daisy(290,236,24);
    out+=heart(198,236,22,'pink',-8);

    /* Wrapping paper */
    out+='<path d="M200 550L36 262Q118 214 200 234Q282 214 364 262Z" '+
      fill('lilac')+'/>';
    out+='<path d="M200 550L36 262Q118 214 200 234" '+
      'style="fill:none;stroke:var(--lilac-deep);stroke-width:1.5;opacity:.35"/>';

    out+='<path d="M200 550L94 302Q148 274 200 296Q252 274 306 302Z" '+
      fill('pink')+'/>';

    var px=[120,150,176,224,250,280];

    for(i=0;i<px.length;i++){
      out+='<path d="M200 546L'+px[i]+' 298" '+
        'style="fill:none;stroke:var(--blush);stroke-width:1.5;opacity:.6"/>';
    }

    /* Ribbon */
    out+='<path d="M100 310Q200 350 300 310L288 338Q200 376 112
